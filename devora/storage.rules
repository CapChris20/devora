rules_version = '2';

// Firebase Storage rules for profile photos under users/{userId}/...
// WHY: only Michigan students may read classmate avatars; only the owner may upload;
// uploads must be images under a size cap so Storage is not a free malware drop.

service firebase.storage {
  match /b/{bucket}/o {
    function isUmichEmail(email) {
      return email is string
        && (
          email.matches('.*@umich\\.edu$')
          || email.matches('.*@umd\\.umich\\.edu$')
        );
    }

    function isUmichUser() {
      return request.auth != null && isUmichEmail(request.auth.token.email);
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Manipulate here: raise max size if CECS headshots need more than 5 MiB
    function isAllowedImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/{fileName} {
      allow read: if isUmichUser();
      allow write: if isUmichUser() && isOwner(userId) && isAllowedImageUpload();
    }
  }
}
