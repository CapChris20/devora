rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isUmichUser() {
      return request.auth != null
        && request.auth.token.email.matches('.*@umich\\.edu$');
    }

    match /users/{userId} {
      allow read: if isUmichUser();
      allow create, update, delete: if isUmichUser() && request.auth.uid == userId;
    }

    match /conversations/{conversationId} {
      allow read, write: if isUmichUser()
        && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read, write: if isUmichUser()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if isUmichUser() && request.auth.uid == userId;
    }

    match /users/{userId}/projects/{projectId} {
      allow read: if isUmichUser();
      allow write: if isUmichUser() && request.auth.uid == userId;
    }
  }
}
