rules_version = '2';

// Firestore access for Devora.
// Security model:
// - users/{uid} is OWNER ONLY (full profile, including email / religion / etc.)
// - discoveryProfiles/{uid} is the ONLY classmate-readable projection (no private fields)
// - Writes are allowlisted so clients cannot invent arbitrary keys

service cloud.firestore {
  match /databases/{database}/documents {
    function isUmichEmail(email) {
      return email is string
        && (
          email.matches('.*@umich\\.edu$')
          || email.matches('.*@umd\\.umich\\.edu$')
        );
    }

    function isUmichUser() {
      return request.auth != null && isUmichEmail(request.auth.token.email);
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isEmailLockedToAuth() {
      return request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email;
    }

    // Keys a student may put on their owner profile document.
    function ownerProfileKeysAreAllowed() {
      return request.resource.data.keys().hasOnly([
        'email',
        'firstName',
        'lastName',
        'displayName',
        'classRank',
        'gender',
        'age',
        'major',
        'careerNiche',
        'careerNicheOther',
        'hasExperience',
        'experienceDetails',
        'casualInterests',
        'aboutYou',
        'religion',
        'signupReason',
        'bio',
        'photoURL',
        'links',
        'school',
        'isPublic',
        'isDeactivated',
        'preferences',
        'onboardingComplete',
        'createdAt',
        'updatedAt',
        'deactivatedAt'
      ]);
    }

    // Public projection must never carry private / sensitive owner fields.
    function discoveryProfileHasNoPrivateFields() {
      return !('email' in request.resource.data)
        && !('religion' in request.resource.data)
        && !('signupReason' in request.resource.data)
        && !('gender' in request.resource.data)
        && !('age' in request.resource.data);
    }

    function discoveryProfileKeysAreAllowed() {
      return request.resource.data.keys().hasOnly([
        'firstName',
        'lastName',
        'displayName',
        'major',
        'classRank',
        'careerNiche',
        'casualInterests',
        'aboutYou',
        'bio',
        'photoURL',
        'links',
        'school',
        'preferences',
        'isPublic',
        'isDeactivated',
        'onboardingComplete',
        'updatedAt'
      ]);
    }

    function isDiscoverableProjection() {
      return resource.data.isPublic == true
        && resource.data.onboardingComplete == true
        && resource.data.get('isDeactivated', false) != true;
    }

    // Full profile — only the signed-in owner.
    match /users/{userId} {
      allow read: if isOwner(userId) && isUmichUser();

      allow create: if isOwner(userId)
        && isUmichUser()
        && isEmailLockedToAuth()
        && ownerProfileKeysAreAllowed();

      allow update: if isOwner(userId)
        && isUmichUser()
        && isEmailLockedToAuth()
        && ownerProfileKeysAreAllowed();

      allow delete: if isOwner(userId) && isUmichUser();

      match /notifications/{notificationId} {
        allow read, write: if isUmichUser() && isOwner(userId);
      }

      match /projects/{projectId} {
        // Owner-only until Showcase needs classmate reads.
        allow read, write: if isUmichUser() && isOwner(userId);
      }
    }

    // Public Discovery cards — Michigan classmates may read discoverable projections only.
    match /discoveryProfiles/{userId} {
      allow read: if isUmichUser() && isDiscoverableProjection();

      allow create, update: if isOwner(userId)
        && isUmichUser()
        && discoveryProfileHasNoPrivateFields()
        && discoveryProfileKeysAreAllowed()
        && request.resource.data.onboardingComplete is bool
        && request.resource.data.isPublic is bool;

      allow delete: if isOwner(userId) && isUmichUser();
    }

    match /conversations/{conversationId} {
      allow read: if isUmichUser()
        && request.auth.uid in resource.data.participantIds;

      allow create: if isUmichUser()
        && request.auth.uid in request.resource.data.participantIds;

      allow update, delete: if isUmichUser()
        && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read, write: if isUmichUser()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }
  }
}
